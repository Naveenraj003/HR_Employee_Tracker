# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=hospital_user
DB_PASSWORD=hospital_password
DB_NAME=hospital_tracker_dev

# Local defaults (non-Docker run)
# If you installed PostgreSQL locally, these values should work out of the box.
# Ensure a role `hospital_user` exists with the password above and DB `hospital_tracker_dev` is created.

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

# MFA Configuration
MFA_ISSUER=HospitalTracker
MFA_WINDOW=1

# API Configuration
API_PORT=3002
NODE_ENV=production
API_ENV=development
API_LOG_LEVEL=debug

# Frontend Configuration
REACT_APP_API_BASE_URL=http://localhost:3000/api

# Session Configuration
SESSION_TIMEOUT=1800

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png

# CORS Configuration
CORS_ORIGIN=http://localhost:3001
